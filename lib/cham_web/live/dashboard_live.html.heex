<div class="app">
  <%!-- Sidebar --%>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <.link navigate={~p"/"} class="wordmark" style="text-decoration: none;">Cham</.link>
      <span class="khmer">ចាំ</span>
    </div>

    <button
      class="btn btn-tint"
      style="justify-content: flex-start;"
      phx-click={show_modal("submit-modal")}
    >
      <.icon name="hero-plus" class="h-4 w-4" /> Add URL
    </button>

    <%!-- In Progress --%>
    <div class="sidebar-section">
      <button
        class="disclosure-btn"
        aria-expanded={if @show_in_progress, do: "true", else: "false"}
        phx-click="toggle_in_progress"
      >
        <span>
          <span class="caret">▶</span> In Progress
          <span :if={@active_count > 0} style="opacity: 0.6;">({@active_count})</span>
        </span>
      </button>
      <div :if={@show_in_progress} style="display: flex; flex-direction: column; gap: 4px; margin-top: 6px;">
        <div :if={Enum.empty?(@in_progress)} style="font-size: var(--cham-text-xs); color: var(--cham-fg-faint); padding: 0 var(--cham-space-2);">
          Nothing in progress
        </div>
        <.link
          :for={item <- @in_progress}
          navigate={~p"/items/#{item.id}"}
          class="ingest-row"
          style="text-decoration: none;"
        >
          <.status_badge status={item.status} />
          <span class="url">{item.title || truncate_url(item.url)}</span>
        </.link>
      </div>
    </div>

    <%!-- Content type facets (with icons) --%>
    <div class="sidebar-section">
      <div class="sidebar-eyebrow">Content</div>
      <button
        :for={{type, count} <- Enum.sort(@type_counts)}
        phx-click="filter_type"
        phx-value-type={type}
        data-filter-type={type}
        class={["facet", @active_type == type && "is-active"]}
      >
        <span style="display: inline-flex; align-items: center; gap: 8px;">
          <.icon name={content_type_icon(type)} class="h-4 w-4" />
          {content_type_label(type)}
        </span>
        <span class="count">{count}</span>
      </button>
    </div>

    <%!-- Tags (collapsed panel, one per row, button rows — no pills) --%>
    <div class="sidebar-section" style="flex: 1; min-height: 0;">
      <button
        class="disclosure-btn"
        aria-expanded={if @show_tags, do: "true", else: "false"}
        phx-click="toggle_tags"
      >
        <span>
          <span class="caret">▶</span> Tags
          <span :if={map_size(@tag_counts) > 0} style="opacity: 0.6;">({map_size(@tag_counts)})</span>
        </span>
      </button>
      <div :if={@show_tags} style="margin-top: 6px; overflow-y: auto;">
        <div :if={map_size(@tag_counts) == 0} style="font-size: var(--cham-text-xs); color: var(--cham-fg-faint);">
          No tags yet
        </div>
        <div style="display: flex; flex-direction: column; gap: 2px;">
          <button
            :for={{tag, count} <- Enum.sort_by(@tag_counts, fn {t, c} -> {-c, t} end)}
            phx-click="filter_tag"
            phx-value-tag={tag}
            class={["facet", @active_tag == tag && "is-active"]}
          >
            <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{tag}</span>
            <span class="count">{count}</span>
          </button>
        </div>
      </div>
    </div>

    <%!-- Footer links --%>
    <div class="sidebar-section">
      <.link
        navigate={~p"/subscriptions"}
        class="facet"
        style="text-decoration: none;"
      >
        <span style="display: inline-flex; align-items: center; gap: 8px;">
          <.icon name="hero-rss" class="h-4 w-4" /> Subscriptions
        </span>
      </.link>
      <.link
        navigate={~p"/config"}
        class="facet"
        style="text-decoration: none;"
      >
        <span style="display: inline-flex; align-items: center; gap: 8px;">
          <.icon name="hero-cog-6-tooth" class="h-4 w-4" /> Settings
        </span>
      </.link>
    </div>
  </aside>

  <%!-- Main column --%>
  <div class="main">
    <div class="dashboard">
      <h1 class="hero">{raw(hero_text(assigns))}</h1>
      <p class="hero-sub">A pocket for the entire web.</p>

      <form phx-change="search" phx-submit="search" class="search-wrap">
        <span class="search-icon">
          <.icon name="hero-magnifying-glass" class="h-4 w-4" />
        </span>
        <input
          type="text"
          name="q"
          value={@search_query}
          phx-debounce="300"
          placeholder="Search your archive..."
          class="search-input"
        />
      </form>

      <%!-- Empty state --%>
      <div :if={Enum.empty?(@items) && @total_count == 0} class="empty">
        <p style="margin: 0 0 var(--cham-space-4);">Nothing archived yet. Submit your first URL to get started.</p>
        <button class="btn btn-primary" phx-click={show_modal("submit-modal")}>
          <.icon name="hero-plus" class="h-4 w-4" /> Submit your first URL
        </button>
      </div>

      <%!-- Filtered empty state --%>
      <div :if={Enum.empty?(@items) && @total_count > 0} class="empty">
        No items match this filter. Try removing the filter to see all items.
      </div>

      <%!-- Card grid for video --%>
      <div :if={not Enum.empty?(@items) && @active_type == "video"} class="video-grid">
        <.link
          :for={item <- @items}
          navigate={~p"/items/#{item.id}?#{return_params(assigns)}"}
          class="video-card"
        >
          <% thumb = Cham.Items.best_thumbnail_url(item) %>
          <div class="video-thumb">
            <img
              :if={thumb}
              src={thumb}
              alt=""
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0;"
            />
          </div>
          <div class="video-meta">
            <h3 class="video-title">
              {Cham.Items.best_title(item) || truncate_url(item.url)}
            </h3>
            <div class="video-sub">{video_meta_line(item)}</div>
          </div>
        </.link>
      </div>

      <%!-- Card grid for documents --%>
      <div :if={not Enum.empty?(@items) && @active_type == "document"} class="doc-grid">
        <.link
          :for={item <- @items}
          navigate={~p"/items/#{item.id}?#{return_params(assigns)}"}
          class="doc-card"
        >
          <div class="doc-thumb">
            <div class="doc-page">
              <div class="l h"></div>
              <div :for={w <- [80, 60, 75, 90, 65, 80, 70, 85]} class="l" style={"width: #{w}%;"}></div>
            </div>
          </div>
          <div class="doc-meta">
            <h3 class="doc-title">{Cham.Items.best_title(item) || truncate_url(item.url)}</h3>
            <div class="doc-sub">{meta_line(item)}</div>
          </div>
        </.link>
      </div>

      <%!-- List rows for articles/other, grouped by day --%>
      <div :if={not Enum.empty?(@items) && @active_type not in ["video", "document"]}>
        <section :for={{label, group_items} <- group_items_by_day(@items)} style="margin-bottom: var(--cham-space-6);">
          <h2 class="sidebar-eyebrow" style="margin-bottom: var(--cham-space-2);">{label}</h2>
          <div>
            <.link
              :for={item <- group_items}
              navigate={~p"/items/#{item.id}?#{return_params(assigns)}"}
              class="row"
            >
              <div class="row-body">
                <h3 class="row-title">
                  {Cham.Items.best_title(item) || item.title || truncate_url(item.url)}
                </h3>
                <p
                  :if={excerpt = item.metadata["excerpt"]}
                  class="row-excerpt"
                >
                  {excerpt}
                </p>
                <div class="row-meta">
                  <.content_type_badge type={item.content_type} />
                  <span>{meta_line(item)}</span>
                  <span class="sep">·</span>
                  <.relative_time at={item.inserted_at} />
                </div>
              </div>
              <div style="display: flex; align-items: center; flex-shrink: 0;">
                <.status_badge status={item.status} />
              </div>
            </.link>
          </div>
        </section>
      </div>

      <%!-- Pagination --%>
      <nav
        :if={@total_pages > 1}
        aria-label="Pagination"
        style="margin-top: var(--cham-space-6); display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--cham-border-subtle); padding-top: var(--cham-space-4);"
      >
        <div style="font-size: var(--cham-text-sm); color: var(--cham-fg-soft); font-family: var(--cham-font-mono);">
          Page {@page} of {@total_pages} · {@filtered_count} total
        </div>
        <div style="display: flex; gap: var(--cham-space-2);">
          <%= if @page > 1 do %>
            <.link patch={~p"/?#{page_params(assigns, @page - 1)}"} class="btn btn-ghost">
              Previous
            </.link>
          <% else %>
            <span class="btn btn-ghost" style="opacity: 0.4; cursor: not-allowed;">Previous</span>
          <% end %>
          <%= if @page < @total_pages do %>
            <.link patch={~p"/?#{page_params(assigns, @page + 1)}"} class="btn btn-ghost">
              Next
            </.link>
          <% else %>
            <span class="btn btn-ghost" style="opacity: 0.4; cursor: not-allowed;">Next</span>
          <% end %>
        </div>
      </nav>
    </div>
  </div>
</div>

<.modal id="submit-modal">
  <div style="font: var(--cham-fw-semibold) var(--cham-text-xl)/1.2 var(--cham-font-display); color: var(--cham-fg-strong); margin-bottom: var(--cham-space-4);">
    Add URL
  </div>
  <form id="submit-form" phx-submit="submit_url" style="display: flex; flex-direction: column; gap: var(--cham-space-4);">
    <div>
      <input
        type="url"
        name="url"
        placeholder="https://..."
        required
        class="search-input"
        style="padding: 10px 14px;"
        phx-mounted={JS.focus()}
      />
      <p :if={@submit_error} style="margin-top: 4px; font-size: var(--cham-text-sm); color: var(--cham-stage-fail-fg);">{@submit_error}</p>
    </div>
    <div style="display: flex; justify-content: flex-end; gap: var(--cham-space-2);">
      <button type="submit" class="btn btn-primary">Submit</button>
    </div>
  </form>
</.modal>
