<div style="min-height: 100vh; background: var(--cham-surface-page);">
  <div class="item-topbar">
    <.link
      navigate={~p"/subscriptions"}
      class="iconbtn"
      style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; padding: 4px 8px; font-size: var(--cham-text-sm); color: var(--cham-fg-muted);"
    >
      <.icon name="hero-arrow-left-mini" class="h-4 w-4" /> Subscriptions
    </.link>
  </div>

  <main style="max-width: 64rem; margin: 0 auto; padding: var(--cham-space-12) var(--cham-space-8) var(--cham-space-8);">
    <h1 style="font: var(--cham-fw-normal) var(--cham-text-3xl)/1.2 var(--cham-font-display); color: var(--cham-fg-strong); letter-spacing: var(--cham-track-tight); margin: 0 0 var(--cham-space-6);">
      Configuration
    </h1>

    <div style="display: flex; gap: var(--cham-space-8); align-items: flex-start;">
      <%!-- Section list --%>
      <div style="width: 16rem; flex-shrink: 0;">
        <div :if={@system_sections != []} style="margin-bottom: var(--cham-space-6);">
          <h2 class="sidebar-eyebrow" style="margin: 0 0 var(--cham-space-3);">System</h2>
          <div style="display: flex; flex-direction: column; gap: 2px;">
            <button
              :for={section <- @system_sections}
              phx-click="select_section"
              phx-value-namespace={section.namespace}
              phx-value-name={section.name}
              class={[
                "facet",
                "facet-stack",
                @active_section && @active_section.namespace == section.namespace && "is-active"
              ]}
              style="flex-direction: column; align-items: flex-start; gap: 2px; padding: var(--cham-space-2) var(--cham-space-3); height: auto;"
            >
              <span style="font-weight: var(--cham-fw-medium); font-size: var(--cham-text-sm); color: var(--cham-fg);">
                {section.name}
              </span>
              <span style="font-size: var(--cham-text-xs); color: var(--cham-fg-faint);">
                {length(section.schema)} settings
              </span>
            </button>
          </div>
        </div>

        <div :if={@subscription_backends != []} style="margin-bottom: var(--cham-space-6);">
          <h2 class="sidebar-eyebrow" style="margin: 0 0 var(--cham-space-3);">Subscriptions</h2>
          <div style="display: flex; flex-direction: column; gap: 2px;">
            <button
              :for={backend <- @subscription_backends}
              phx-click="select_section"
              phx-value-namespace={backend.namespace}
              phx-value-name={backend.name}
              disabled={backend.schema == []}
              class={[
                "facet",
                "facet-stack",
                @active_section && @active_section.namespace == backend.namespace && "is-active"
              ]}
              style={[
                "flex-direction: column; align-items: flex-start; gap: 2px; padding: var(--cham-space-2) var(--cham-space-3); height: auto;",
                if(backend.schema == [], do: " opacity: 0.5; cursor: not-allowed;", else: "")
              ]}
            >
              <span style="font-weight: var(--cham-fw-medium); font-size: var(--cham-text-sm); color: var(--cham-fg);">
                {backend.name}
              </span>
              <span style="font-size: var(--cham-text-xs); color: var(--cham-fg-faint);">
                {if backend.schema != [],
                  do: "#{length(backend.schema)} settings",
                  else: "No settings"}
              </span>
            </button>
          </div>
        </div>

        <h2 class="sidebar-eyebrow" style="margin: 0 0 var(--cham-space-3);">Plugins</h2>
        <div style="display: flex; flex-direction: column; gap: 2px;">
          <button
            :for={plugin <- @plugins}
            phx-click="select_section"
            phx-value-namespace={plugin.namespace}
            phx-value-name={plugin.name}
            disabled={!has_config?(plugin)}
            class={[
              "facet",
              "facet-stack",
              @active_section && @active_section.namespace == plugin.namespace && "is-active"
            ]}
            style={[
              "flex-direction: column; align-items: flex-start; gap: 2px; padding: var(--cham-space-2) var(--cham-space-3); height: auto;",
              if(!has_config?(plugin), do: " opacity: 0.5; cursor: not-allowed;", else: "")
            ]}
          >
            <span style="font-weight: var(--cham-fw-medium); font-size: var(--cham-text-sm); color: var(--cham-fg);">
              {plugin.name}
            </span>
            <span style="font-size: var(--cham-text-xs); color: var(--cham-fg-faint);">
              {if has_config?(plugin),
                do: "#{length(plugin.schema)} settings",
                else: "No settings"}
            </span>
          </button>
        </div>
      </div>

      <%!-- Config form --%>
      <div style="flex: 1; min-width: 0;">
        <div
          :if={!@active_section}
          style="text-align: center; padding: var(--cham-space-12) 0; color: var(--cham-fg-faint);"
        >
          <.icon name="hero-cog-6-tooth" class="h-12 w-12 mx-auto mb-4" />
          <p style="margin: 0; font-size: var(--cham-text-sm);">Select a section to configure</p>
        </div>

        <div :if={@active_section}>
          <div style="margin-bottom: var(--cham-space-6);">
            <h2 style="font: var(--cham-fw-semibold) var(--cham-text-lg)/1.3 var(--cham-font-display); color: var(--cham-fg-strong); letter-spacing: var(--cham-track-tight); margin: 0;">
              {@active_section.name}
            </h2>
            <p
              :if={@active_section.description != ""}
              style="margin: 4px 0 0; font-size: var(--cham-text-sm); color: var(--cham-fg-soft);"
            >
              {@active_section.description}
            </p>
          </div>

          <div
            :if={@save_result == :ok}
            style="margin-bottom: var(--cham-space-4); border-radius: var(--cham-radius-md); background: var(--cham-stage-done-bg); border: 1px solid var(--cham-stage-done-fg); padding: var(--cham-space-3) var(--cham-space-4); font-size: var(--cham-text-sm); color: var(--cham-stage-done-fg);"
          >
            Configuration saved successfully.
          </div>

          <div
            :if={match?({:error, _}, @save_result)}
            style="margin-bottom: var(--cham-space-4); border-radius: var(--cham-radius-md); background: var(--cham-stage-fail-bg); border: 1px solid var(--cham-stage-fail-fg); padding: var(--cham-space-3) var(--cham-space-4); font-size: var(--cham-text-sm); color: var(--cham-stage-fail-fg);"
          >
            Failed to save: {inspect(elem(@save_result, 1))}
          </div>

          <form
            phx-submit="save_config"
            style="display: flex; flex-direction: column; gap: var(--cham-space-5); padding: var(--cham-space-5); border: 1px solid var(--cham-border-subtle); border-radius: var(--cham-radius-md); background: var(--cham-surface);"
          >
            <div
              :for={field <- @active_section.schema}
              style="display: flex; flex-direction: column; gap: 4px;"
            >
              <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--cham-space-2);">
                <label
                  for={"config-#{field.key}"}
                  style="display: flex; align-items: center; gap: var(--cham-space-2); font-size: var(--cham-text-sm); font-weight: var(--cham-fw-medium); color: var(--cham-fg-muted);"
                  title={Atom.to_string(field.key)}
                  data-raw-key={Atom.to_string(field.key)}
                >
                  <span>{humanize_key(field.key)}</span>
                  <%= if Map.get(@overridden, Atom.to_string(field.key)) do %>
                    <span class="stage-badge is-active">overridden</span>
                  <% else %>
                    <span class="stage-badge is-info" style="opacity: 0.6;">default</span>
                  <% end %>
                </label>
                <button
                  :if={Map.get(@overridden, Atom.to_string(field.key))}
                  type="button"
                  phx-click="reset_key"
                  phx-value-key={Atom.to_string(field.key)}
                  style="background: none; border: none; cursor: pointer; font-size: var(--cham-text-xs); color: var(--cham-accent-fg); padding: 0;"
                >
                  Reset to default
                </button>
              </div>
              <p
                :if={field[:description]}
                style="margin: 0; font-size: var(--cham-text-xs); color: var(--cham-fg-soft);"
              >
                {field[:description]}
              </p>

              <%= if field.type == :boolean do %>
                <div style="display: flex; align-items: center; gap: var(--cham-space-3);">
                  <input type="hidden" name={Atom.to_string(field.key)} value="false" />
                  <input
                    type="checkbox"
                    name={Atom.to_string(field.key)}
                    id={"config-#{field.key}"}
                    value="true"
                    checked={Map.get(@form_values, Atom.to_string(field.key)) == "true"}
                  />
                </div>
              <% else %>
                <%= if field[:options] do %>
                  <select
                    name={Atom.to_string(field.key)}
                    id={"config-#{field.key}"}
                    class="search-input"
                    style="padding: 8px 12px;"
                  >
                    <option
                      :for={opt <- field.options}
                      value={opt}
                      selected={
                        Map.get(@form_values, Atom.to_string(field.key)) == to_string(opt)
                      }
                    >
                      {opt}
                    </option>
                  </select>
                <% else %>
                  <%= if long_text?(field) do %>
                    <textarea
                      name={Atom.to_string(field.key)}
                      id={"config-#{field.key}"}
                      rows="6"
                      placeholder={if field.default, do: "Default: #{field.default}", else: ""}
                      class="search-input"
                      style="padding: 8px 12px; font-family: var(--cham-font-mono); font-size: var(--cham-text-xs);"
                    >{Map.get(@form_values, Atom.to_string(field.key), "")}</textarea>
                  <% else %>
                    <input
                      type={input_type(field.type)}
                      name={Atom.to_string(field.key)}
                      id={"config-#{field.key}"}
                      value={Map.get(@form_values, Atom.to_string(field.key), "")}
                      placeholder={if field.default, do: "Default: #{field.default}", else: ""}
                      class="search-input"
                      style="padding: 8px 12px;"
                    />
                  <% end %>
                <% end %>
              <% end %>
            </div>

            <div style="padding-top: var(--cham-space-4); border-top: 1px solid var(--cham-border-subtle);">
              <button type="submit" class="btn btn-primary">Save Configuration</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>
