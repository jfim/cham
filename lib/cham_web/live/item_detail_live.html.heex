<div class="min-h-screen bg-gray-50">
  <%!-- Top Bar --%>
  <div class="bg-white border-b border-gray-200 px-8 py-4">
    <div class="flex items-center justify-between">
      <.link
        navigate={@return_path}
        class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1"
      >
        <.icon name="hero-arrow-left-mini" class="h-4 w-4" /> Back to archive
      </.link>
      <div class="flex items-center gap-2">
        <.status_badge :if={is_processing?(@item)} status={@item.status} />
        <span
          :for={tag <- @item.tags || []}
          class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600"
        >
          {tag}
        </span>
      </div>
    </div>
  </div>

  <%!-- Primary Content --%>
  <div class="max-w-4xl mx-auto px-8 py-8">
    <%!-- Header --%>
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">{@item.title || "Untitled"}</h1>
      <div class="flex items-center gap-3 text-sm text-gray-500">
        <.content_type_badge :if={@item.content_type} type={@item.content_type} />
        <a href={@item.url} target="_blank" rel="noopener" class="hover:text-indigo-600">
          {domain_from_url(@item.url)} ↗
        </a>
        <.relative_time at={@item.inserted_at} />
      </div>
      <%= if @subscription do %>
        <p class="provenance text-sm text-gray-600 mt-1">
          from
          <.link navigate={~p"/subscriptions/#{@subscription.id}"}>{@subscription.title}</.link>
        </p>
      <% end %>
    </div>

    <%!-- Feed Subscribe Section --%>
    <%= if @item.content_type == "feed" and (not is_nil(@feed_metadata) or not is_nil(@existing_subscription)) do %>
      <section class="mt-6 border-t pt-4">
        <%= if @existing_subscription do %>
          <p>
            <.link
              navigate={~p"/subscriptions/#{@existing_subscription.id}"}
              class="underline text-blue-600"
            >
              View existing subscription
            </.link>
          </p>
        <% else %>
          <h2 class="text-xl font-semibold mb-2">Subscribe to {@feed_metadata["title"]}</h2>
          <%= if @feed_metadata["description"] do %>
            <p class="text-sm text-gray-600 mb-4">{@feed_metadata["description"]}</p>
          <% end %>

          <h3 class="font-medium text-sm mb-1">Recent entries</h3>
          <ul class="text-sm mb-4">
            <%= for entry <- Enum.take(@feed_metadata["entries"] || [], 10) do %>
              <li class="py-0.5">
                {entry["title"]}
                <%= if entry["timestamp"] do %>
                  <span class="text-gray-500">— {entry["timestamp"]}</span>
                <% end %>
              </li>
            <% end %>
          </ul>

          <%!-- TODO: "Display as feed" toggle to show archived raw XML is not yet implemented
               because the archived XML is not easily accessible via the current artifact API.
               The feed_metadata artifact stores parsed JSON, not the raw XML. --%>

          <.form for={%{}} phx-submit="subscribe" class="space-y-3 max-w-md">
            <div>
              <label class="block text-sm font-medium">Title</label>
              <input
                name="title"
                value={@feed_metadata["title"]}
                class="border px-2 py-1 w-full"
              />
            </div>

            <div>
              <label class="block text-sm font-medium">Poll interval</label>
              <select name="poll_interval_seconds" class="border px-2 py-1">
                <option value="3600">1 hour</option>
                <option value="21600">6 hours</option>
                <option value="86400" selected>24 hours</option>
              </select>
            </div>

            <fieldset class="border p-2">
              <legend class="text-sm font-medium px-1">Backfill</legend>
              <label class="block">
                <input type="radio" name="backfill[mode]" value="none" checked />
                None (ingest new items only)
              </label>
              <label class="block">
                <input type="radio" name="backfill[mode]" value="last_n" /> Last
                <input
                  type="number"
                  name="backfill[n]"
                  value="10"
                  class="border px-1 w-16"
                  min="1"
                /> items
              </label>
              <label class="block">
                <input type="radio" name="backfill[mode]" value="since" /> Since
                <input type="date" name="backfill[date]" class="border px-1" />
              </label>
            </fieldset>

            <button type="submit" class="bg-blue-600 text-white px-3 py-1 rounded">
              Subscribe
            </button>
          </.form>
        <% end %>
      </section>
    <% end %>
    <%!-- Processing View --%>
    <div :if={is_processing?(@item)} class="mb-8 rounded-lg border border-gray-200 bg-white p-6">
      <h2 class="text-sm font-semibold text-gray-700 mb-4">Processing Pipeline</h2>
      <div :if={@stage_history == []} class="text-sm text-gray-400">
        Waiting for pipeline to start...
      </div>
      <div :if={@stage_history != []} class="space-y-3">
        <div :for={stage <- @stage_history} class="flex items-center gap-3 text-sm">
          <.status_badge status={stage.status} />
          <span class="font-medium text-gray-700">{stage.stage}</span>
          <span :if={stage.duration_ms} class="text-gray-400">{stage.duration_ms}ms</span>
          <span :if={stage.error} class="text-red-500 text-xs">{stage.error}</span>
        </div>
      </div>
      <%!-- Progress bars for active stages --%>
      <div :for={{stage_id, prog} <- @progress} class="mt-2">
        <div class="text-xs font-medium text-gray-600 mb-1">{stage_id}</div>
        <.progress_bar progress={prog.progress} message={prog.message} />
      </div>
    </div>

    <%!-- Primary Content Area --%>
    <div :if={@item.content_type == "article"} class="mb-8">
      <.content_state state={@primary_content.state} error={@primary_content.error}>
        <div class="prose prose-gray max-w-none bg-white rounded-lg border border-gray-200 p-8">
          {raw(@primary_content.html || @primary_content.content)}
        </div>
      </.content_state>
    </div>

    <div :if={@item.content_type == "video"} class="mb-8">
      <div :if={@original_file_url} class="rounded-lg overflow-hidden border border-gray-200">
        <video controls class="w-full" preload="metadata">
          <source src={@original_file_url} /> Your browser does not support the video tag.
        </video>
      </div>
      <div
        :if={!@original_file_url}
        class="aspect-video bg-gray-100 rounded-lg flex items-center justify-center"
      >
        <div class="text-center text-gray-400">
          <.icon name="hero-play-circle" class="h-12 w-12 mx-auto mb-2" />
          <p>Video file not available</p>
          <a
            href={@item.url}
            target="_blank"
            rel="noopener"
            class="text-sm text-indigo-600 hover:text-indigo-500"
          >
            Watch on original site ↗
          </a>
        </div>
      </div>
    </div>

    <div :if={@item.content_type == "document"} class="mb-8">
      <div :if={@original_file_url} class="rounded-lg overflow-hidden border border-gray-200">
        <iframe src={@original_file_url} class="w-full" style="height: 70vh;"></iframe>
      </div>
      <div
        :if={!@original_file_url}
        class="aspect-[3/4] max-h-96 bg-gray-100 rounded-lg flex items-center justify-center"
      >
        <div class="text-center text-gray-400">
          <.icon name="hero-document-text" class="h-12 w-12 mx-auto mb-2" />
          <p>PDF file not available</p>
          <a
            href={@item.url}
            target="_blank"
            rel="noopener"
            class="text-sm text-indigo-600 hover:text-indigo-500"
          >
            View original ↗
          </a>
        </div>
      </div>
    </div>

    <div :if={@item.content_type not in ["article", "video", "document"]} class="mb-8">
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <p class="text-sm text-gray-500 mb-4">Available artifacts:</p>
        <div :if={@artifacts == []} class="text-sm text-gray-400">No artifacts yet</div>
        <div :for={artifact <- @artifacts} class="text-sm text-gray-600 mb-1">
          <span class="font-mono text-xs bg-gray-100 px-1 rounded">{artifact.stage}</span>
          <span :for={{k, v} <- artifact.labels} class="ml-2 text-gray-400">{k}:{v}</span>
        </div>
      </div>
    </div>

    <%!-- Bottom Pane --%>
    <div class="rounded-lg border border-gray-200 bg-white">
      <%!-- Tab Bar --%>
      <div class="flex border-b border-gray-200">
        <button
          :for={tab <- tabs_for(@item)}
          phx-click="select_tab"
          phx-value-tab={tab}
          data-tab={tab}
          class={[
            "px-4 py-3 text-sm font-medium border-b-2 -mb-px",
            if(@active_tab == tab,
              do: "border-indigo-500 text-indigo-600",
              else: "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"
            )
          ]}
        >
          {tab_label(tab)}
        </button>
      </div>

      <%!-- Tab Content --%>
      <div :if={@active_tab} class="p-6">
        <div :if={@active_tab == "summary"}>
          <.content_state state={@summary.state} error={@summary.error}>
            <div class="prose prose-gray max-w-none">
              {raw(@summary.html || @summary.content)}
            </div>
          </.content_state>
        </div>

        <div :if={@active_tab == "transcript"}>
          <.content_state state={@transcript.state} error={@transcript.error}>
            <div class="prose prose-gray max-w-none max-h-96 overflow-y-auto">
              <pre class="whitespace-pre-wrap font-sans text-sm">{@transcript.content}</pre>
            </div>
          </.content_state>
        </div>

        <div :if={@active_tab == "pipeline"}>
          <div :if={@stage_history == []} class="text-sm text-gray-400 py-4">
            No pipeline stages have run yet.
          </div>
          <table :if={@stage_history != []} class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b border-gray-200">
                <th class="pb-2 pr-4">Stage</th>
                <th class="pb-2 pr-4">Status</th>
                <th class="pb-2 pr-4">Duration</th>
                <th class="pb-2 pr-4">Started</th>
                <th class="pb-2">Details</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={stage <- @stage_history} class="border-b border-gray-100">
                <td class="py-2 pr-4 font-medium text-gray-700">{stage.stage}</td>
                <td class="py-2 pr-4">
                  <.status_badge status={stage.status} />
                </td>
                <td class="py-2 pr-4 text-gray-500">
                  {format_duration(stage.duration_ms)}
                </td>
                <td class="py-2 pr-4 text-gray-500">
                  <.relative_time :if={stage.started_at} at={stage.started_at} />
                </td>
                <td class="py-2 text-gray-500">
                  <span :if={stage.error} class="text-red-500 text-xs break-all">
                    {String.slice(stage.error || "", 0, 200)}
                  </span>
                  <span :if={stage.snooze_reason} class="text-amber-500 text-xs">
                    Snoozed: {stage.snooze_reason}
                  </span>
                  <span :if={stage.attempt && stage.attempt > 1} class="text-gray-400 text-xs">
                    Attempt {stage.attempt}
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
          <%!-- Progress bars for active stages --%>
          <div :for={{stage_id, prog} <- @progress} class="mt-4">
            <div class="text-xs font-medium text-gray-600 mb-1">{stage_id}</div>
            <.progress_bar progress={prog.progress} message={prog.message} />
          </div>
        </div>

        <div :if={@active_tab == "metadata"}>
          <pre class="text-sm font-mono bg-gray-50 rounded p-4 overflow-x-auto">{@metadata_json}</pre>
        </div>

        <div :if={@active_tab == "chat"} class="text-center py-8 text-gray-400">
          <.icon name="hero-chat-bubble-left-right" class="h-8 w-8 mx-auto mb-2" />
          <p>Chat coming soon</p>
        </div>

        <div :if={@active_tab == "actions"} class="space-y-6">
          <%!-- Retry Failed --%>
          <div
            :if={has_failed_stages?(@stage_history)}
            class="flex items-start gap-4 p-4 bg-red-50 rounded-lg border border-red-200"
          >
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-red-800">Retry Failed Stages</h3>
              <p class="text-xs text-red-600 mt-1">
                Clear failed stage executions and retry them.
              </p>
            </div>
            <button
              phx-click="retry_failed"
              class="shrink-0 inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-500"
            >
              <.icon name="hero-arrow-path-mini" class="h-4 w-4" /> Retry Failed
            </button>
          </div>

          <%!-- Per-stage Rerun --%>
          <div :if={@stage_history != []}>
            <h3 class="text-sm font-semibold text-gray-700 mb-3">Rerun Individual Stages</h3>
            <p class="text-xs text-gray-500 mb-3">
              Invalidate a stage and its downstream dependencies, then reprocess.
            </p>
            <div class="space-y-2">
              <div
                :for={stage_id <- unique_stages(@stage_history)}
                class="flex items-center justify-between py-2 px-3 rounded-md bg-gray-50 border border-gray-200"
              >
                <span class="text-sm font-medium text-gray-700">{stage_id}</span>
                <button
                  phx-click="invalidate_stage"
                  phx-value-stage={stage_id}
                  class="inline-flex items-center gap-1 rounded-md bg-white px-2.5 py-1.5 text-xs font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
                >
                  <.icon name="hero-arrow-path-mini" class="h-3.5 w-3.5" /> Rerun
                </button>
              </div>
            </div>
          </div>

          <%!-- Reprocess All --%>
          <div
            :if={@stage_history != []}
            class="flex items-start gap-4 p-4 bg-amber-50 rounded-lg border border-amber-200"
          >
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-amber-800">Reprocess Everything</h3>
              <p class="text-xs text-amber-600 mt-1">
                Invalidate all stages and reprocess from scratch.
              </p>
            </div>
            <button
              phx-click="reprocess_all"
              data-confirm="This will invalidate all stages and reprocess the item from scratch. Continue?"
              class="shrink-0 inline-flex items-center gap-1.5 rounded-md bg-amber-600 px-3 py-2 text-sm font-medium text-white hover:bg-amber-500"
            >
              <.icon name="hero-arrow-path-mini" class="h-4 w-4" /> Reprocess All
            </button>
          </div>

          <%!-- Empty state --%>
          <div :if={@stage_history == []} class="text-center py-8 text-gray-400">
            <.icon name="hero-cog-6-tooth" class="h-8 w-8 mx-auto mb-2" />
            <p>No pipeline stages to manage yet.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
